---
const skillCategories = [
  {
    name: 'Frontend',
    skills: ['HTML/CSS', 'JavaScript', 'TypeScript', 'React', 'Astro'],
  },
  {
    name: 'Backend',
    skills: ['Node.js', 'Python', 'APIs', 'Databases'],
  },
  {
    name: 'Tools & DevOps',
    skills: ['Git', 'GitHub Actions', 'Docker', 'Linux'],
  },
];
---

<section class="skills" id="skills">
  <div class="skills__container">
    <h2 class="section-title">Skills &amp; Tools</h2>
    <p class="section-desc">Technologies I work with regularly.</p>

    <div class="skills__grid">
      {skillCategories.map((category) => (
        <div class="skill-category">
          <h3 class="skill-category__name">{category.name}</h3>
          <div class="skill-category__tags">
            {category.skills.map((skill) => <span class="tag tag--skill">{skill}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    padding: 6rem 2rem;
    background: rgba(255, 255, 255, 0.015);
  }

  .skills__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skill-category {
    padding: 1.75rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .skill-category__name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .skill-category__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
